// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelo basado en la pantalla "Crea tu cuenta"
model User {
  id            String   @id @default(uuid())
  name          String   // Campo: "Nombre completo"
  email         String   @unique // Campo: "Correo electrónico"
  password      String   // Campo: "Contraseña" (Se guardará hasheada)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relación: Un usuario tiene muchas suscripciones
  subscriptions Subscription[] 
}

// Modelo basado en las pantallas "Añadir una suscripción" (Pasos 1 y 2)
model Subscription {
  id           String   @id @default(uuid())
  
  // Datos principales (Paso 1 y 2 del diseño)
  name         String   // Campo: "Nombre de la suscripción" (ej. Netflix)
  price        Decimal  @db.Decimal(10, 2) // Campo: "Precio" (ej. 14.99)
  currency     String   // Campo: "Divisa" (ej. USD, EUR - viene del dropdown)
  billingCycle String   // Campo: "Ciclo de facturación" (ej. Mensual - viene del dropdown)
  startDate    DateTime // Campo: "Fecha de primer pago"
  
  // Datos opcionales y lógica
  notes        String?  // Campo: "Notas adicionales" (El ? lo hace opcional)
  isActive     Boolean  @default(true) // Para "Soft Delete" (cuando el usuario elimine)
  
  // Campos técnicos (No visibles en UI, pero necesarios)
  reminderDays Int      @default(3) // HU-12: Días previos para notificar (Por defecto 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación con Usuario (Foreign Key)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}