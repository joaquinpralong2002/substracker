generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String   // Campo: "Nombre completo"
  email         String   @unique // Campo: "Correo electrónico"
  password      String   // Campo: "Contraseña" (Se guardará hasheada)
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relación: Un usuario tiene muchas suscripciones
  subscriptions Subscription[] 

  @@map("users")
}

model Subscription {
  id           String   @id @default(cuid())
  
  // Datos principales 
  name         String   // Campo: "Nombre de la suscripción" (ej. Netflix)
  price        Decimal  @db.Decimal(10, 2) // Campo: "Precio" (ej. 14.99)
  currency     Currency @default(USD)  // Campo: "Divisa" (ej. USD, EUR - viene del dropdown)
  billingCycle BillingCycle @default(Mensual) @map("billing_cycle")  // Campo: "Ciclo de facturación" (ej. Mensual - viene del dropdown)
  startDate    DateTime @map("start_date") // Campo: "Fecha de primer pago" 
  nextPaymentDate DateTime @map("next_payment_date") // Campo: "Fecha de próximo pago"
  
  // Datos opcionales y lógica
  notes        String?  // Campo: "Notas adicionales"
  isActive     Boolean  @default(true) @map("is_active") // Para "Soft Delete" (cuando el usuario elimine)
  
  // Campos técnicos (No visibles en UI, pero necesarios)
  reminderDays Int      @default(7) @map("reminder_days") // HU-12: Días previos para notificar (Por defecto 7)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relación con Usuario (Foreign Key)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextPaymentDate])
  @@map("subscriptions")
}

enum Currency{
  USD
  EUR
  GBP
  JPY
  AUD
  CAD
  CHF
  CNY
  SEK
  NZD
  ARS
  @@map("currencies")
}

enum BillingCycle{
  Mensual
  Trimestral
  Semestral
  Anual
  @@map("billing_cycles")
}